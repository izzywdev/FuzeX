# design-frames-service backend (Postgres lifecycle tier) — environment.
#
# FuzeInfra provisions DATABASE_URL as a SealedSecret in every real
# environment (see ../db/README.md "Provisioning boundary" — this repo never
# creates databases/roles). Export it yourself only against a local/scratch
# Postgres you control; never point it at a shared/prod instance from a
# developer machine.
DATABASE_URL=postgres://user:password@localhost:5432/design_frames

# Comma-separated bearer tokens accepted for write operations. Empty/unset =
# UNAUTHENTICATED writes (local dev only — matches ../server.js's convention).
DESIGN_FRAMES_API_TOKENS=

# Port this tier listens on. Deliberately different from ../server.js's
# DESIGN_FRAMES_PORT (default 4400) so both can run side by side during
# rollout (see docs/postgres-tier.md "Migration path").
DESIGN_FRAMES_PG_PORT=4410
DESIGN_FRAMES_HOST=0.0.0.0

# LOG_LEVEL: info in prod; set to debug to see boundary timing (pg query
# start/end/elapsedMs) without a redeploy — see the `logging` skill.
LOG_LEVEL=info

# Where frame CONTENT lives (manifest.json + frame *.html) — same convention
# as ../lib/store.js. Defaults to ../data/features when unset.
DESIGN_FRAMES_DATA_DIR=
