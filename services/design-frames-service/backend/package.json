{
  "name": "@fuzex/design-frames-backend",
  "version": "0.1.0",
  "description": "Isolated Express + pg + TypeScript lifecycle tier for design-frames-service (services/design-frames-service/docs/postgres-tier.md). SEPARATE from the vanilla ../server.js — additive, mountable/runnable alongside it, never a rewrite of it.",
  "private": true,
  "license": "MIT",
  "main": "dist/index.js",
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "dev": "npm run build && node dist/index.js",
    "backfill": "npm run build && node dist/scripts/backfill.js",
    "test": "npm run build && node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@fuzex/identity": "file:../../../packages/identity",
    "@izzywdev/fuzefront-service-auth": "0.1.0",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.13.3",
    "@types/pg": "^8.11.10",
    "typescript": "^5.5.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/izzywdev/FuzeX.git",
    "directory": "services/design-frames-service/backend"
  }
}
